        "kind": "m",
        "expression": "\"Documentos Compartilhados\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "queryGroup": "00 Parâmetros"
      },
      {
        "name": "pPastaMapeamentos",
        "kind": "m",
        "expression": "\"DEMANDAS NN - ALIANÇA/DEMANDAS NN - ALIANÇAS\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "queryGroup": "00 Parâmetros"
      },
      {
        "name": "pPastaHistorico",
        "kind": "m",
        "expression": "\"DEMANDAS NN - ALIANÇA/HISTORICO\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "queryGroup": "00 Parâmetros"
      },
      {
        "name": "pAbaMapeamento",
