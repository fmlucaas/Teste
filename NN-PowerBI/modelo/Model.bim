      },
      {
        "name": "68a7c380-054f-c6a5-a640-778879348ebf",
        "fromTable": "Histórico Snapshots",
        "fromColumn": "Responsável Final",
        "toTable": "Equipe",
        "toColumn": "Pessoa"
      }
    ],
    "expressions": [
      {
        "name": "pSiteSharePoint",
        "kind": "m",
        "expression": "\"https://emspocbi.sharepoint.com/sites/NOVOSNEGCIOS\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
