          },
          {
            "name": "Data de recebimento da primeira proposta comercial",
            "dataType": "dateTime",
            "sourceColumn": "Data de recebimento da primeira proposta comercial",
            "formatString": "dd/mm/yyyy",
            "summarizeBy": "none"
          },
          {
            "name": "Dias em NN",
